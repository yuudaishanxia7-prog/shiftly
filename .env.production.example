# Vercel runtime: Supabase Transaction pooler (port 6543).
DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Prisma Migrate / pg_dump: Supabase Session pooler (port 5432), or Direct connection when IPv6 is available.
DIRECT_URL="postgresql://USER.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require"

AUTH_SECRET="replace-with-openssl-rand-base64-32-output"
AUTH_URL="https://your-production-domain.example"
AUTH_TRUST_HOST="true"
ENABLE_DEMO_MODE="false"
NEXT_PUBLIC_ENABLE_DEMO_MODE="false"

# One-time only. Keep these local, run db:init-manager, then delete them.
INITIAL_STORE_NAME="Your Store Name"
INITIAL_MANAGER_NAME="Initial Manager"
INITIAL_MANAGER_EMAIL="manager@example.com"
INITIAL_MANAGER_PASSWORD="replace-with-a-strong-random-password"
INITIAL_BUSINESS_START_TIME="07:00"
INITIAL_BUSINESS_END_TIME="20:00"
INITIAL_SHIFT_INTERVAL_MINUTES="30"
